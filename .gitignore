# Claude Code local config — intentionally NOT committed
.claude/

# The spec is the source of truth (see CLAUDE.md), so it is versioned — an
# unreviewable spec cannot govern anything. Working notes stay local.
.specify/
# Working notes (design, eval, plans) stay local; only the project overview ships.
docs/*
!docs/index.html
CLAUDE.md
README.md

# Env & secrets
.env
.env.*
!.env.example

# Python
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store

# iCloud sync-conflict copies ("module 2.py" beside "module.py"). Stale by
# definition; pytest is told to skip them too (see pyproject addopts).
* [0-9].*

# Local data / vector store dumps
data/local/
volumes/

# Run traces (one JSONL per run, FR-009) — audit artefacts, not source
logs/

# Terraform / OpenTofu working state — never committed
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
crash.log
*.tfvars
!*.tfvars.example

# Front-end build artefacts
front/node_modules/
front/dist/

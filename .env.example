# LLM provider: "vertex" (default target), "gemini", "local" or "fake"
LLM_PROVIDER=vertex

# Gemini Developer API — same models as Vertex, reached with an API key instead
# of gcloud ADC. The quickest path to a live demo on a laptop.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_EMBED_MODEL=gemini-embedding-2
VERTEX_PROJECT=your-gcp-project
VERTEX_LOCATION=europe-west1
VERTEX_MODEL=gemini-3.5-flash
VERTEX_EMBED_MODEL=gemini-embedding-2
# Embedding width. Leave unset to adopt whatever the model emits; pin it only to
# force a specific (e.g. Matryoshka-truncated) output width.
# EMBED_DIM=768
# Local fallback (e.g. Ollama OpenAI-compatible endpoint)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1
# Datastores
DATABASE_URL=postgresql://arp:arp@localhost:5432/arp
REDIS_URL=redis://localhost:6379/0
# Synthetic corpus location. Unset resolves to ./data/synthetic in a source
# checkout; the container image sets it to /app/data/synthetic.
# DATA_DIR=./data/synthetic
# Logging — always to stdout, never a file. "console" is readable on a laptop;
# the container sets "json" so the platform's log system ingests every field.
LOG_LEVEL=INFO
LOG_FORMAT=console
# LOG_DIAGNOSE dumps local variables into tracebacks (handy in dev, can leak
# secrets) — keep it off outside local debugging.
# LOG_DIAGNOSE=false
# The run audit is emitted to stdout and indexed in the run store. Point this at
# a writable directory to *also* keep a JSONL file per run; unset in containers.
# RUN_TRACE_DIR=./logs/runs
